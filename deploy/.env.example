# Copy to ".env" next to docker-compose.yml on the server and fill in real
# values. NEVER commit the real .env (it holds secrets).

# --- Database (new DB + user in the existing postgres-bots container) -------
# Host depends on how the API reaches Postgres (see docs/deployment.md):
#   - host-published port:  Host=host.docker.internal;Port=5432
#   - postgres docker net:  Host=postgres-bots;Port=5432   (+ attach api to dbnet)
DB_CONNECTION=Host=host.docker.internal;Port=5432;Database=fahrschule;Username=fahrschule_app;Password=CHANGE_ME

# --- JWT signing key (min. 32 chars; generate a random one!) ----------------
# e.g.  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ISSUER=Fahrschule.Api
JWT_AUDIENCE=Fahrschule.Frontend

# --- First admin (seeded once on an empty database) -------------------------
# Login is by USER NAME (no e-mail). The password is temporary - it must be
# changed on the first sign-in.
ADMIN_USERNAME=inhaber
ADMIN_PASSWORD=CHANGE_ME_TEMP_PASSWORD
ADMIN_DISPLAYNAME=Inhaber

# --- Web Push / appointment reminders (KONZEPT 3.5) -------------------------
# VAPID key pair. Generate once with:  npx web-push generate-vapid-keys
# Leave empty to keep push switched off. The PRIVATE key is a secret.
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:admin@fahrschule.pumpline.systems

# --- Local port the web container binds on (host Nginx proxies here) --------
WEB_PORT=8090
